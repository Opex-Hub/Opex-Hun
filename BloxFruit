local Bypasser = {}

-- Randomization utilities
Bypasser.randomDelay = function(min, max)
    wait(math.random(min * 100, max * 100) / 100)
end

-- Human-like mouse movement
Bypasser.humanizeMouse = function(targetPos)
    local mouse = game.Players.LocalPlayer:GetMouse()
    local currentPos = mouse.Position
    local steps = math.random(5, 15)
    for i = 1, steps do
        local lerpPos = currentPos:Lerp(targetPos, i / steps)
        mouse.Move:Fire(lerpPos)
        Bypasser.randomDelay(0.01, 0.05)
    end
end

-- Hook detection functions
local oldGetNilInstances = getnilinstances
getnilinstances = function()
    local instances = oldGetNilInstances()
    local filtered = {}
    for _, inst in pairs(instances) do
        if not inst.Name:find("OPEX") and not inst.Name:find("Toggle") then
            table.insert(filtered, inst)
        end
    end
    return filtered
end

local oldGetConnections = getconnections
getconnections = function(event)
    local connections = oldGetConnections(event)
    local filtered = {}
    for _, conn in pairs(connections) do
        if not conn.Function or not conn.Function:find("OPEX") then
            table.insert(filtered, conn)
        end
    end
    return filtered
end

-- Protect functions with metatables
Bypasser.protectFunction = function(func)
    local mt = getmetatable(func) or {}
    mt.__index = function() return nil end
    mt.__newindex = function() return nil end
    setmetatable(func, mt)
    return func
end

-- Obfuscate names
local obfuscateName = function(name)
    return name:gsub("OPEX", "OX" .. math.random(1000, 9999))
end

-- Initialize bypasser
Bypasser.init = function()
    print("Bypasser initialized")
    -- Additional anti-detection measures can be added here
end

