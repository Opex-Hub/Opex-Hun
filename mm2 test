task.spawn(function()
    while task.wait() do
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local hum = LocalPlayer.Character.Humanoid
            if hum.WalkSpeed ~= Config.Local.WalkSpeed then
                hum.WalkSpeed = Config.Local.WalkSpeed
            end
            if hum.JumpPower ~= Config.Local.JumpPower then
                hum.JumpPower = Config.Local.JumpPower
                hum.UseJumpPower = true
            end
        end

        if Config.Misc.Fullbright then
            Lighting.Ambient = Color3.new(1, 1, 1)
            Lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
            Lighting.ColorShift_Top = Color3.new(1, 1, 1)
            Lighting.GlobalShadows = false
        end

        if Config.Combat.HitboxExpander then
            local myRole, _ = GetPlayerRole(LocalPlayer)
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local targetRole, _ = GetPlayerRole(p)
                    local hrp = p.Character.HumanoidRootPart
                    
                    if (myRole == "Murderer") or (targetRole == "Murderer") then
                        hrp.Size = Vector3.new(Config.Combat.HitboxSize, Config.Combat.HitboxSize, Config.Combat.HitboxSize)
                        hrp.Transparency = Config.Combat.HitboxTransparency
                        hrp.BrickColor = BrickColor.new("Bright red")
                        hrp.Material = Enum.Material.Neon
                        hrp.CanCollide = false
                    else
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if Config.Farm.AutoCoin and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local normal = Workspace:FindFirstChild("Normal")
            if normal and normal:FindFirstChild("CoinContainer") then
                for _, coin in pairs(normal.CoinContainer:GetChildren()) do
                    if Config.Farm.AutoCoin and coin.Name == "Coin_Server" then
                        local tween = TweenTo(coin.CFrame, Config.Farm.CoinTweenSpeed)
                        if tween then 
                            tween.Completed:Wait() 
                        end
                        task.wait(0.2)
                    end
                end
            end
        end
    end
end)

